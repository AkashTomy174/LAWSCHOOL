# ---------------------------------------------------------------------------
# LawSchool frontend - copy to `.env` and adjust.
#
# Anything prefixed with VITE_ is embedded in the client bundle and is therefore
# PUBLIC.  Never put API secrets, the Razorpay key *secret* or Cloudflare tokens
# here - only the public key ids the browser legitimately needs.
# ---------------------------------------------------------------------------

# Base URL for API calls. Leave empty to use the Vite dev proxy (recommended in
# development so requests stay same-origin).
VITE_API_BASE_URL=/api/v1

# Where the dev server forwards /api when running `npm run dev`.
VITE_PROXY_TARGET=http://localhost:8000

# Public Razorpay key id (safe to expose; the secret never leaves the backend).
VITE_RAZORPAY_KEY_ID=

# Cloudflare Stream customer subdomain code, used to build player URLs.
# Playback still requires a short-lived signed token minted by Django.
VITE_CLOUDFLARE_CUSTOMER_CODE=