# ---------------------------------------------------------------------------
# Build context exclusions for the frontend image.
#
# node_modules is excluded because the Dockerfile runs `npm ci` inside the image;
# copying the host's directory would break platform-specific native binaries.
# ---------------------------------------------------------------------------

# Dependencies (installed inside the image instead)
node_modules/
.pnpm-store/

# Build output (regenerated by `npm run build`)
dist/
dist-ssr/
.vite/

# Secrets / env (VITE_* values are public, but keep local .env out regardless)
.env
.env.*
!.env.example

# Test / lint caches
coverage/
.nyc_output/

# VCS / editors / OS
.git/
.gitignore
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
vite.out.log
vite.err.log
