# ---------------------------------------------------------------------------
# LawSchool frontend -- development image.
#
# Runs the Vite dev server with HMR.  The Vite config already proxies /api to
# VITE_PROXY_TARGET, so set that to http://backend:8000 inside compose.
# ---------------------------------------------------------------------------
FROM node:22-alpine

WORKDIR /app

ENV VITE_PROXY_TARGET=http://backend:8000

# Install dependencies in their own layer so a source edit does not reinstall.
COPY package.json package-lock.json* ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]