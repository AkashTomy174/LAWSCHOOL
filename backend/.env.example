# ---------------------------------------------------------------------------
# LawSchool backend — copy to `.env` and fill in.  NEVER commit the real file.
#     Copy-Item .env.example .env      (Windows PowerShell)
#     cp .env.example .env             (macOS/Linux)
# ---------------------------------------------------------------------------

# --- Django ---------------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
LOG_JSON=False

# --- Database -------------------------------------------------------------
# Local: sqlite against the file below (or point at the Docker Postgres).
# DATABASE_URL=sqlite:///db.sqlite3
DATABASE_URL=postgres://lawschool:lawschool@localhost:5432/lawschool

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Redis is not required for local development.  `CACHE_BACKEND=locmem` swaps the
# cache for an in-process one so the API runs with no external services; the
# entitlement logic re-reads the database either way, so behaviour is identical
# (only slower under load).
CACHE_BACKEND=redis
# --- JWT ------------------------------------------------------------------
# Defaults to SECRET_KEY when blank, but a separate value is recommended so a
# Django secret rotation does not silently invalidate every session.
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- CORS / CSRF ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email ----------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LawSchool <no-reply@lawschool.local>

# --- Razorpay -------------------------------------------------------------
# Dashboard → Settings → API Keys, and Webhooks → signing secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudflare Stream ----------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Dashboard → Stream → Settings → Signing Keys, formatted "<key_id>:<secret>".
CLOUDFLARE_STREAM_SIGNING_KEY=
# Customer subdomain code (the "customer-<code>" part of playback URLs).
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Playback token lifetime in seconds.  Keep short.
CLOUDFLARE_PLAYBACK_TOKEN_TTL=300

# --- Domain tuning --------------------------------------------------------
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
VIDEO_PROGRESS_MAX_DRIFT_SECONDS=30
MAX_IMAGE_UPLOAD_BYTES=5242880

# --- Production-only ------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000